<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="家計簿.db3" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="query browser structure pragmas" current="0"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="1444"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><table title="支出" custom_title="0" dock_id="1" table="4,6:main支出"/><dock_state state="000000ff00000000fd00000001000000020000038b000002fafc0100000001fb000000160064006f0063006b00420072006f007700730065003101000000000000038b0000013400ffffff0000038b0000000000000004000000040000000800000008fc00000000"/><default_encoding codec=""/><browse_table_settings><table schema="main" name="支出" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="32"/><column index="2" value="87"/><column index="3" value="75"/><column index="4" value="47"/><column index="5" value="59"/><column index="6" value="72"/><column index="7" value="139"/><column index="8" value="34"/><column index="9" value="39"/><column index="10" value="91"/><column index="11" value="34"/><column index="12" value="34"/><column index="13" value="37"/><column index="14" value="39"/><column index="15" value="55"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="支出STR" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="32"/><column index="2" value="108"/><column index="3" value="75"/><column index="4" value="47"/><column index="5" value="59"/><column index="6" value="72"/><column index="7" value="139"/><column index="8" value="34"/><column index="9" value="47"/><column index="10" value="91"/><column index="11" value="34"/><column index="12" value="34"/><column index="13" value="37"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="支出.sql">DROP TABLE 支出;

CREATE TABLE 支出 (
	No	INTEGER not NULL,
	日付	TEXT,
	口座	TEXT,
	大分類	TEXT,
	中分類	TEXT,
	小分類	TEXT,
	項目	TEXT,
	数量	numeric,
	金額	numeric,
	取引先	TEXT,
	備考	TEXT,
	周期	TEXT,
	Mark	TEXT,
	YY	INTEGER,
	YM	INTEGER
	,PRIMARY KEY(
		No
	)
);

</sql><sql name="変換する">--支出STRテーブルを支出テーブルに変換する

DELETE FROM 支出;

WITH 日付分解 AS (
    SELECT
        &quot;No.&quot; as No,
        日付,
        口座,大分類,中分類,小分類,項目,
        数量,
        金額,
        取引先,備考,周期,Mark,
CAST(substr(日付, 1, instr(日付, '/') - 1) AS INTEGER) AS 年,
CAST(
  substr(
    日付,
    instr(日付, '/') + 1,
    instr(substr(日付, instr(日付, '/') + 1), '/') - 1
  ) AS INTEGER
) AS 月,		
CAST(
  substr(
    日付,
    instr(日付, '/') + instr(substr(日付, instr(日付, '/') + 1), '/') + 1,
    instr(日付, '(')
      - instr(日付, '/')
      - instr(substr(日付, instr(日付, '/') + 1), '/')
      - 1
  ) AS INTEGER
) AS 日
    FROM 支出STR
),
変換後 AS (
    SELECT
        No,
        printf('%04d-%02d-%02d', 年, 月, 日) AS 日付,
        口座,大分類,中分類,小分類,項目,
        CASE
           WHEN TRIM(数量) LIKE '(%)' THEN
             -CAST(REPLACE(REPLACE(REPLACE(数量, ',', ''),'(',''),')','') AS NUMERIC)
           ELSE
             CAST(REPLACE(数量, ',', '') AS NUMERIC)
         END AS 数量,
        CASE
           WHEN TRIM(金額) LIKE '(%)' THEN
             -CAST(REPLACE(REPLACE(REPLACE(金額, ',', ''),'(',''),')','') AS NUMERIC)
           ELSE
             CAST(REPLACE(金額, ',', '') AS NUMERIC)
         END AS 金額,
        取引先,備考,周期,Mark,
        年 AS YY,
        年 * 100 + 月 AS YM
    FROM 日付分解
)
INSERT INTO 支出 (
    No,日付,口座,大分類,中分類,小分類,項目,数量,金額,取引先,備考,周期,Mark,YY,YM
)
SELECT
    No,日付,口座,大分類,中分類,小分類,項目,数量,金額,取引先,備考,周期,Mark,YY,YM
FROM 変換後;

</sql><sql name="支出_idx.sql">create unique index 支出_idx00 on 支出 (
	No
);

create  index 支出_idx01 on 支出 (
	大分類,
	中分類,
	小分類
);

</sql><sql name="支出_dropidx.sql">drop index 支出_idx00;

drop index 支出_idx01;

</sql><sql name="塗りDML生成">SELECT DISTINCT 大分類,  中分類,  小分類,  項目 
 FROM 支出 
 WHERE 小分類 like '%おにぎり%' or 項目 like '%おにぎり%'; 

UPDATE 支出 SET 小分類= 'おむすび' WHERE 大分類= '食費' and  中分類= '主食' and  小分類= 'おにぎり';

DELETE  FROM 支出 WHERE 項目= 'クーポン';

SELECT 大分類,  中分類,  小分類,  数量,  金額,  YM FROM 支出;

SELECT YM, 大分類,  中分類,  小分類,  sum(数量) as 数量,  sum(金額) as 金額
 FROM 支出
 group by YM,大分類,  中分類,  小分類 
;

SELECT YM, 大分類,  中分類,    sum(数量) as 数量,  sum(金額) as 金額
 FROM 支出
 group by YM,大分類,  中分類 
;

SELECT YM, 大分類,      sum(数量) as 数量,  sum(金額) as 金額
 FROM 支出
 group by YM,大分類 
;
